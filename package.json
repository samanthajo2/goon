{
  "name": "goon",
  "productName": "Goon",
  "version": "0.0.28",
  "type": "module",
  "description": "Multiple Movie/Photo Viewer",
  "build": {
    "appId": "com.samanthajo.goon",
    "asar": true,
    "mac": {
      "category": "public.app-category.lifestyle",
      "identity": null
    },
    "files": [
      "package.json",
      "main.js",
      "**/node_modules/**/*",
      "out/**/*",
      "app/**/*"
    ],
    "extraResources": [
      {
        "from": "resources",
        "to": "."
      }
    ]
  },
  "main": "main.js",
  "scripts": {
    "build-app": "tsc",
    "build-renderer": "node tools/build-renderer.js",
    "watch-app": "tsc --watch",
    "watch-renderer": "node tools/build-renderer.js --watch",
    "watch": "npm run watch-app & npm run watch-renderer",
    "build": "npm run build-app && npm run build-renderer",
    "clean": "rimraf out",
    "start": "node tools/launch.js development",
    "startp": "node tools/launch.js production",
    "unit-tests": "mocha --node-option enable-source-maps --import ./test/register-electron-mock.js --recursive out/**/*.test.js",
    "integration-tests": "mocha --node-option enable-source-maps --recursive test/integration/**/*.test.js",
    "lint": "eslint . --max-warnings 0",
    "test": "npm run clean && npm run lint && npm run build && npm run unit-tests && npm run integration-tests",
    "pack": "electron-builder --dir",
    "dist": "electron-builder --publish never",
    "publish": "electron-builder --publish always"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/samanthajo2/goon.git"
  },
  "keywords": [
    "Goon",
    "image",
    "images",
    "video",
    "videos"
  ],
  "author": "samanthajo",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/samanthajo2/goon/issues"
  },
  "homepage": "https://github.com/samanthajo2/goon#readme",
  "devDependencies": {
    "@eslint-react/eslint-plugin": "^4.2.3",
    "@eslint/js": "^10.0.1",
    "@tsconfig/recommended": "^1.0.13",
    "@types/chai": "^5.2.3",
    "@types/express": "^5.0.6",
    "@types/graceful-fs": "^4.1.9",
    "@types/hjson": "^2.4.6",
    "@types/mime-types": "^3.0.1",
    "@types/mocha": "^10.0.10",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/sinon": "^21.0.1",
    "chai": "^6.2.2",
    "electron": "^41.2.0",
    "electron-builder": "^26.8.1",
    "esbuild": "^0.28.0",
    "eslint": "^10.2.0",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.32.0",
    "globals": "^17.4.0",
    "mocha": "^11.7.5",
    "node-cleanup": "^2.1.2",
    "sinon": "^21.0.3",
    "temp": "^0.9.4",
    "tslib": "^2.8.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.58.1"
  },
  "dependencies": {
    "asar": "^3.2.0",
    "chalk": "^5.6.2",
    "chokidar": "^5.0.0",
    "commander": "^14.0.3",
    "debug": "^4.4.3",
    "electron-updater": "^6.8.3",
    "exifreader": "^4.38.0",
    "express": "^5.2.1",
    "graceful-fs": "^4.2.11",
    "hjson": "^3.2.2",
    "keycode": "^2.2.1",
    "mime-types": "^3.0.2",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "rimraf": "^6.1.3",
    "unrarit": "^0.0.6",
    "unzipit": "^2.0.1"
  }
}
