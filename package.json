{
  "name": "goon",
  "productName": "Goon",
  "version": "1.0.13",
  "type": "module",
  "description": "Multiple Movie/Photo Viewer",
  "build": {
    "appId": "com.samanthajo.goon",
    "asar": true,
    "asarUnpack": [
      "**/*.node"
    ],
    "mac": {
      "category": "public.app-category.lifestyle",
      "identity": null
    },
    "dmg": {
      "contents": [
        {
          "x": 130,
          "y": 220,
          "type": "file"
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        },
        {
          "x": 270,
          "y": 80,
          "type": "file",
          "path": "build/How To Run.txt"
        }
      ],
      "window": {
        "width": 540,
        "height": 480
      }
    },
    "files": [
      "package.json",
      "main.js",
      "**/node_modules/**/*",
      "out/**/*",
      "app/**/*"
    ],
    "extraResources": [
      {
        "from": "resources",
        "to": "."
      }
    ]
  },
  "main": "main.js",
  "scripts": {
    "build-app": "tsc",
    "build-renderer": "node tools/build-renderer.js",
    "watch-app": "tsc --watch",
    "watch-renderer": "node tools/build-renderer.js --watch",
    "watch": "npm run watch-app & npm run watch-renderer",
    "build": "npm run build-app && npm run build-renderer",
    "clean": "rimraf out",
    "start": "node tools/launch.js development",
    "start-capture": "node tools/launch.js development --capture",
    "startp": "node tools/launch.js production",
    "start-test": "node tools/run-with-test-data.js",
    "clean-test-runs": "node tools/clean-test-runs.js",
    "unit-tests": "mocha --node-option enable-source-maps --import ./test/register-dom.js --import ./test/register-electron-mock.js --recursive out/**/*.test.js",
    "integration-tests": "mocha --node-option enable-source-maps --recursive test/integration/**/*.test.js",
    "lint": "eslint . --max-warnings 0",
    "test": "npm run clean && npm run lint && npm run build && npm run unit-tests && npm run integration-tests",
    "pack": "electron-builder --dir",
    "dist": "electron-builder --publish never",
    "publish": "electron-builder --publish always"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/samanthajo2/goon.git"
  },
  "keywords": [
    "Goon",
    "image",
    "images",
    "video",
    "videos"
  ],
  "author": "samanthajo",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/samanthajo2/goon/issues"
  },
  "homepage": "https://github.com/samanthajo2/goon#readme",
  "devDependencies": {
    "@eslint-react/eslint-plugin": "^4.2.3",
    "@eslint/js": "^10.0.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@tsconfig/recommended": "^1.0.13",
    "@types/chai": "^5.2.3",
    "@types/express": "^5.0.6",
    "@types/graceful-fs": "^4.1.9",
    "@types/hjson": "^2.4.6",
    "@types/mime-types": "^3.0.1",
    "@types/mocha": "^10.0.10",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/sinon": "^21.0.1",
    "@types/ws": "^8.18.1",
    "chai": "^6.2.2",
    "electron": "^41.3.0",
    "electron-builder": "^26.8.1",
    "esbuild": "^0.28.0",
    "eslint": "^10.2.1",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.32.0",
    "globals": "^17.5.0",
    "happy-dom": "^20.11.6",
    "mocha": "^11.7.5",
    "sinon": "^21.1.2",
    "temp": "^0.9.4",
    "tslib": "^2.8.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.59.1"
  },
  "dependencies": {
    "@parcel/watcher": "^2.5.6",
    "asar": "^3.2.0",
    "chalk": "^5.6.2",
    "commander": "^14.0.3",
    "debug": "^4.4.3",
    "events": "^3.3.0",
    "exifreader": "^4.38.1",
    "express": "^5.2.1",
    "graceful-fs": "^4.2.11",
    "hjson": "^3.2.2",
    "mime-types": "^3.0.2",
    "path-browserify": "^1.0.1",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "rimraf": "^6.1.3",
    "unrarit": "^0.0.6",
    "unzipit": "^2.0.1",
    "ws": "^8.20.0"
  }
}
