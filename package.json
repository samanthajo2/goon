{
  "name": "goon",
  "productName": "Goon",
  "version": "0.0.7",
  "description": "Multiple Movie/Photo Viewer",
  "build": {
    "appId": "com.samanthajo.goon",
    "asar": true,
    "mac": {
      "category": "public.app-category.lifestyle",
      "identity": null
    },
    "files": [
      "package.json",
      "main.js",
      "**/node_modules/**/*",
      "out/**/*",
      "app/**/*"
    ],
    "extraResources": [
      {
        "from": "resources",
        "to": "."
      }
    ]
  },
  "main": "main.js",
  "scripts": {
    "build-app": "tsc",
    "watch-app": "tsc --watch",
    "watch": "npm run watch-app",
    "build": "npm run build-app",
    "start": "cross-env NODE_ENV=development electron main.js",
    "startp": "cross-env NODE_ENV=production electron main.js",
    "unit-tests": "mocha --require source-map-support/register --recursive out/**/*.test.js",
    "integration-tests": "mocha --require source-map-support/register --recursive test/integration/**/*.test.js",
    "lint": "eslint \"src/**\"",
    "test": "npm run lint && npm run build && npm run unit-tests && npm run integration-tests",
    "pack": "electron-builder --dir",
    "dist": "electron-builder --publish never",
    "publish": "electron-builder --publish always"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/samanthajo2/goon.git"
  },
  "keywords": [
    "Goon",
    "image",
    "images",
    "video",
    "videos"
  ],
  "author": "samanthajo",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/samanthajo2/goon/issues"
  },
  "homepage": "https://github.com/samanthajo2/goon#readme",
  "devDependencies": {
    "@tsconfig/recommended": "^1.0.10",
    "@types/express": "^5.0.3",
    "@types/hjson": "^2.4.6",
    "@types/lodash": "^4.17.18",
    "@types/mime-types": "^3.0.1",
    "@types/react": "^17.0.87",
    "@types/react-dom": "^17.0.26",
    "@typescript-eslint/eslint-plugin": "^8.35.0",
    "@typescript-eslint/parser": "^8.35.0",
    "chai": "^4.5.0",
    "cross-env": "^7.0.3",
    "electron": "^36.5.0",
    "electron-builder": "^23.6.0",
    "eslint": "^8.57.1",
    "eslint-config-airbnb": "^19.0.4",
    "eslint-import-resolver-typescript": "^4.4.3",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-optional-comma-spacing": "0.0.4",
    "eslint-plugin-react": "^7.37.5",
    "mocha": "^9.2.2",
    "node-cleanup": "^2.1.2",
    "sinon": "^21.0.0",
    "source-map-support": "^0.5.21",
    "temp": "^0.9.4",
    "tslib": "^2.8.1",
    "typescript": "^5.8.3"
  },
  "dependencies": {
    "@electron/remote": "^2.1.2",
    "asar": "^3.2.0",
    "chalk": "^4.1.2",
    "chokidar": "^3.6.0",
    "commander": "^14.0.0",
    "debug": "^4.4.1",
    "electron-updater": "^4.6.5",
    "es6-promisify": "^7.0.0",
    "express": "^5.1.0",
    "graceful-fs": "^4.2.11",
    "hjson": "^3.2.2",
    "immutability-helper": "^3.1.1",
    "keycode": "^2.2.1",
    "lodash": "^4.17.21",
    "lodash.throttle": "^4.1.1",
    "mime-types": "^2.1.35",
    "mobx": "^6.13.7",
    "mobx-react": "^7.6.0",
    "moment": "^2.30.1",
    "other-window-ipc": "^1.3.1",
    "prop-types": "^15.8.1",
    "react": "^17.0.2",
    "react-dom": "^17.0.2",
    "react-list": "^0.8.18",
    "react-measure": "^2.5.2",
    "react-reflex": "^4.2.7",
    "rimraf": "^3.0.2",
    "unzipit": "^1.4.3"
  }
}
