{
  "extends": "@tsconfig/recommended/tsconfig.json",
  "compilerOptions": {
    "target": "ESNext",
    "module": "commonjs",
    "outDir": "out/js",
    "moduleResolution": "node",
    "declaration": true,
    "typeRoots": [
      "./node_modules/@types",
    ],
    "experimentalDecorators": true,
    "resolveJsonModule": true,
    "allowJs": true,
    "inlineSources": true,
    "inlineSourceMap": true,
    "jsx": "react",
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.js",
    "src/**/*.jsx",
    "src/**/*.tsx",
    "tools/**/*.js",
    "tools/**/*.mjs",
  ],
  "exclude": [
    "app/**/*",
    "node_modules",
    "out",
    "examples/3rdparty/**/*.js",
    "test/mocha.js",
  ],
}